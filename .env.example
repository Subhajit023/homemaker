# Copy this file to `.env.local` and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings → API (or the "Connect" button).
# The publishable (anon) key is safe to ship in the app; access is protected by the
# Row Level Security rules in supabase/migrations.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
